# Copia este archivo como .env en la raíz del proyecto (se lee al arrancar, sin
# pisar variables ya definidas). La configuración principal vive en
# ~/.crisvis/crisvis.toml (créala con `npm run setup` o `uv run python -m crisvis init`);
# estas variables, si existen, tienen prioridad sobre ese archivo.
# Los secretos se quedan en el núcleo Python: nunca llegan al navegador.

# Carpeta de datos (configuración, memoria, auditoría). Por defecto ~/.crisvis
# CRISVIS_HOME=

# Servidor
# CRISVIS_HOST=127.0.0.1
# CRISVIS_PORT=8787

# Cerebro OpenJarvis
# CRISVIS_MOTOR=ollama
# CRISVIS_MODELO=qwen3:8b

# Permisos: lectura | confirmar | libre
# CRISVIS_PERMISOS=confirmar

# Voz en la nube (opcional): mejor voz y transcripción
# ELEVENLABS_API_KEY=

# Herramienta del tiempo de OpenJarvis (opcional)
# OPENWEATHERMAP_API_KEY=

# Carpetas extra desde las que la interfaz puede mostrar imágenes (separadas por ;)
# CRISVIS_FILE_ROOTS=
